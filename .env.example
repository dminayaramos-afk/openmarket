# OpenMarket — configuración (copia a .env y ajusta). Nada de esto es obligatorio.
OPENMARKET_HOST=127.0.0.1
OPENMARKET_PORT=8000
OPENMARKET_DB=data/openmarket.db

# Si se define, todos los endpoints /api/* (salvo /api/health) exigen "Authorization: Bearer <token>".
# Obligatorio si expones OpenMarket fuera de localhost.
OPENMARKET_API_TOKEN=

# Si un proveedor falla, mostrar datos SINTÉTICOS etiquetados en lugar de un error (true/false).
OPENMARKET_DEMO_FALLBACK=true
# Desactiva por completo las llamadas a proveedores externos (modo offline / demostración).
OPENMARKET_OFFLINE=false

# Proveedores (todas las claves son opcionales)
# Obligatoria para acciones/ETF/índices/materias primas (gratuita): https://stooq.com/q/d/?s=spy.us&get_apikey
OPENMARKET_STOOQ_APIKEY=
OPENMARKET_FRANKFURTER_URL=https://api.frankfurter.dev/v1
OPENMARKET_KRAKEN_URL=https://api.kraken.com
OPENMARKET_STOOQ_URL=https://stooq.com

# Carpeta con históricos propios en CSV (<SÍMBOLO>.csv): datos reales sin red ni clave. Ver data/prices/LEEME.txt
OPENMARKET_CSV_DIR=data/prices

# Costes simulados (puntos básicos) para paper trading y backtesting
OPENMARKET_SLIPPAGE_BPS=5
OPENMARKET_COMMISSION_BPS=10

# Orígenes CORS permitidos para el frontend en desarrollo (separados por comas)
OPENMARKET_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
